{
  "name": "komunalka",
  "version": "5.2.0",
  "description": "Розумний облік комунальних платежів PWA",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "smoke": "node tests/ui-smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check app.js && node --check worker.js && npm run build && node tests/sanity-check.mjs && npm run smoke && npm test",
    "backup:verify": "node scripts/verify-backup.mjs",
    "demo": "node scripts/dev.mjs --demo",
    "worker:check": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir .wrangler/check"
  },
  "keywords": [
    "pwa",
    "utilities",
    "komunalka",
    "finance"
  ],
  "author": "Антон Миколенко",
  "license": "MIT",
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@fontsource-variable/inter": "5.1.1",
    "@fontsource-variable/inter-tight": "5.1.1",
    "@fortawesome/fontawesome-free": "6.5.1",
    "firebase": "12.18.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "serve": "14.2.6",
    "tailwindcss": "3.4.17",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
