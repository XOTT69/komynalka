{
  "name": "komunalka",
  "version": "5.15.0",
  "description": "Розумний облік комунальних платежів PWA",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "brand:icons": "node scripts/generate-brand.mjs",
    "smoke": "node tests/ui-smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs && npm run build && npm run check:performance && node tests/sanity-check.mjs && npm run smoke && npm test",
    "backup:verify": "node scripts/verify-backup.mjs",
    "demo": "node scripts/dev.mjs --demo",
    "demo:pwa": "node scripts/dev.mjs --demo --pwa",
    "worker:check": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir .wrangler/check",
    "backup:restore-check": "npm run worker:check && node scripts/restore-recovery.mjs",
    "check:layout": "node scripts/check-layout.cjs",
    "check:performance": "node scripts/check-performance.mjs"
  },
  "keywords": [
    "pwa",
    "utilities",
    "komunalka",
    "finance"
  ],
  "author": "Антон Миколенко",
  "license": "MIT",
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@fontsource-variable/inter": "5.1.1",
    "@fontsource-variable/inter-tight": "5.1.1",
    "@fortawesome/fontawesome-free": "6.5.1",
    "firebase": "12.18.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "jsdom": "26.1.0",
    "playwright": "1.63.0",
    "serve": "14.2.6",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "wrangler": "^4.145.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
